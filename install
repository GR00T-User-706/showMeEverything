#!/usr/bin/env bash
# SME_SIGNATURE=gr00t-user-706

set -e

# ============================================================
# showMeEverything Unified Installer
# ============================================================

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# --- Global state ---
SME_ENVIRONMENT=""
SME_SHEBANG=""
SME_PKG_MANAGER=""

SME_CLI_DIR=""
SME_CLI_SRC=""
SME_LAUNCHER_SRC=""

SMECLI_BIN=""
SMECLI=""
SMECLI_MODULE_DIR=""

INSTALL_MODE=""

# ============================================================
# Constants
# ============================================================

readonly SME_SIGNATURE="gr00t-user-706"

readonly SME_LINUX="/usr/bin/env zsh"
readonly SME_TERMUX="${PREFIX:-}/bin/env zsh"

# Required CLI source files
readonly SME_MODULES=(
    "showMeEverything.zsh"
    "config.zsh"
    "shell_searches.zsh"
    "package_manager_searches.zsh"
    "filesystem_searches.zsh"
    "help.zsh"
)

# ============================================================
# Detect installer location
# ============================================================

detect_shell() {

    if [ -n "${ZSH_VERSION:-}" ]; then
        SCRIPT_DIR="${0:A:h}"
        return
    fi

    if [ -n "${BASH_VERSION:-}" ]; then
        SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
        return
    fi

    echo -e "${RED}Unsupported shell. Run this installer with Bash or Zsh.${NC}"
    exit 1
}

# ============================================================
# Detect environment
# ============================================================

detect_environment() {

    local os
    os="$(uname -s 2>/dev/null || true)"

    # --------------------------------------------------------
    # Termux
    # --------------------------------------------------------

    if [ "$os" = "Linux" ] \
        && [ -n "${PREFIX:-}" ] \
        && [ -d "${PREFIX:-/nonexistent}" ] \
        && [ -d "${PREFIX:-/nonexistent}/bin" ] \
        && {
            [ -n "${TERMUX_VERSION:-}" ] ||
            [ -n "${TERMUX_APK_RELEASE:-}" ] ||
            [[ "${PREFIX:-}" == /data/data/*/files/usr ]]
        }
    then
        SME_ENVIRONMENT="TERMUX"
        SME_SHEBANG="$SME_TERMUX"
        return
    fi

    # --------------------------------------------------------
    # Linux
    # --------------------------------------------------------

    if [ "$os" = "Linux" ]; then
        SME_ENVIRONMENT="LINUX"
        SME_SHEBANG="$SME_LINUX"
        return
    fi

    SME_ENVIRONMENT="UNSUPPORTED"
}

# ============================================================
# Define paths
# ============================================================

define_paths() {

    # --------------------------------------------------------
    # Repository source
    # --------------------------------------------------------

    SME_CLI_DIR="$SCRIPT_DIR/src"
    SME_CLI_SRC="$SME_CLI_DIR/showMeEverything.zsh"
    SME_LAUNCHER_SRC="$SME_CLI_DIR/showMeEverything.launcher"

    # --------------------------------------------------------
    # Installation destination
    # --------------------------------------------------------

    if [ "$SME_ENVIRONMENT" = "TERMUX" ]; then

        SMECLI_BIN="$PREFIX/bin/showMeEverything"
        SMECLI="$PREFIX/bin/smecli"
        SMECLI_MODULE_DIR="$PREFIX/lib/showMeEverything"

    else

        SMECLI_BIN="/usr/local/bin/showMeEverything"
        SMECLI="/usr/local/bin/smecli"
        SMECLI_MODULE_DIR="/usr/local/lib/showMeEverything"

    fi
}

# ============================================================
# Repository validation
# ============================================================

check_cli_source() {

    echo
    echo -e "${BLUE}Checking showMeEverything source tree...${NC}"

    if [ ! -d "$SME_CLI_DIR" ]; then
        echo -e "${RED}Missing source directory:${NC}"
        echo "  $SME_CLI_DIR"
        return 1
    fi

    local missing=0
    local module

    for module in "${SME_MODULES[@]}"; do

        if [ ! -f "$SME_CLI_DIR/$module" ]; then
            echo -e "${RED}Missing source file:${NC}"
            echo "  $SME_CLI_DIR/$module"
            missing=1
        fi

    done

    if [ ! -f "$SME_LAUNCHER_SRC" ]; then
        echo -e "${RED}Missing launcher:${NC}"
        echo "  $SME_LAUNCHER_SRC"
        missing=1
    fi

    if [ "$missing" -ne 0 ]; then
        echo
        echo -e "${RED}The CLI source tree is incomplete.${NC}"
        return 1
    fi

    echo -e "${GREEN}CLI source tree is complete.${NC}"
}

# ============================================================
# Determine installation mode
# ============================================================

determine_install_mode() {

    if [ "$SME_ENVIRONMENT" = "UNSUPPORTED" ]; then
        INSTALL_MODE="BROKEN"
        return
    fi

    if [ ! -f "$SME_CLI_SRC" ]; then
        INSTALL_MODE="BROKEN"
        return
    fi

    if [ "$SME_ENVIRONMENT" = "TERMUX" ]; then
        INSTALL_MODE="TERMUX"
        return
    fi

    if [ "$SME_ENVIRONMENT" = "LINUX" ]; then
        INSTALL_MODE="LINUX_CLI"
        return
    fi

    INSTALL_MODE="BROKEN"
}

# ============================================================
# Package manager detection
# ============================================================

detect_package_manager() {

    SME_PKG_MANAGER=""

    # Termux must be checked before generic apt.
    if [ "$SME_ENVIRONMENT" = "TERMUX" ] \
        && command -v pkg >/dev/null 2>&1
    then
        SME_PKG_MANAGER="pkg"
        return
    fi

    if command -v apt-get >/dev/null 2>&1; then
        SME_PKG_MANAGER="apt-get"
        return
    fi

    if command -v dnf >/dev/null 2>&1; then
        SME_PKG_MANAGER="dnf"
        return
    fi

    if command -v pacman >/dev/null 2>&1; then
        SME_PKG_MANAGER="pacman"
        return
    fi

    if command -v zypper >/dev/null 2>&1; then
        SME_PKG_MANAGER="zypper"
        return
    fi

    if command -v apk >/dev/null 2>&1; then
        SME_PKG_MANAGER="apk"
        return
    fi
}

# ============================================================
# Install dependency
# ============================================================

install_dependency() {

    local package_name="$1"
    local package="$2"

    echo
    echo -e "${YELLOW}$package_name is required but is not installed.${NC}"
    read -r -p "Install it now? [Y/n] " answer

    case "$answer" in
        [Nn]*)
            echo -e "${RED}Cannot continue without $package_name.${NC}"
            return 1
            ;;
    esac

    case "$SME_PKG_MANAGER" in

        apt-get)
            apt-get update
            apt-get install -y "$package"
            ;;

        dnf)
            dnf install -y "$package"
            ;;

        pacman)
            pacman -Sy --noconfirm --needed "$package"
            ;;

        zypper)
            zypper --non-interactive install "$package"
            ;;

        apk)
            apk add "$package"
            ;;

        pkg)
            pkg install -y "$package"
            ;;

        *)
            echo -e "${RED}No supported package manager was detected.${NC}"
            return 1
            ;;

    esac
}

# ============================================================
# Check Zsh
# ============================================================

check_zsh() {

    if command -v zsh >/dev/null 2>&1; then
        echo -e "${GREEN}Zsh detected: $(command -v zsh)${NC}"
        return 0
    fi

    echo -e "${YELLOW}Zsh was not found.${NC}"

    detect_package_manager

    if [ -z "$SME_PKG_MANAGER" ]; then
        echo -e "${RED}Unable to determine a package manager.${NC}"
        return 1
    fi

    echo "Package manager: $SME_PKG_MANAGER"

    install_dependency "Zsh" "zsh" || return 1

    if command -v zsh >/dev/null 2>&1; then
        echo -e "${GREEN}Zsh installed successfully.${NC}"
        return 0
    fi

    echo -e "${RED}Zsh installation completed, but Zsh could not be found afterward.${NC}"
    return 1
}

# ============================================================
# Check whether an existing file belongs to SME
# ============================================================

is_sme_file() {

    local file="$1"

    [ -f "$file" ] || return 1

    grep -q "SME_SIGNATURE=$SME_SIGNATURE" "$file" 2>/dev/null
}

# ============================================================
# Check whether installed implementation matches source
# ============================================================

implementation_matches_repo() {

    [ -f "$SMECLI_MODULE_DIR/showMeEverything.zsh" ] || return 1

    local source_hash
    local installed_hash

    source_hash="$(sha256sum "$SME_CLI_SRC" | awk '{print $1}')"
    installed_hash="$(sha256sum "$SMECLI_MODULE_DIR/showMeEverything.zsh" | awk '{print $1}')"

    [ "$source_hash" = "$installed_hash" ]
}

# ============================================================
# Inspect installation target
# ============================================================

check_target() {

    local target="$1"

    [ -e "$target" ] || return 0

    echo
    echo -e "${YELLOW}Existing target detected:${NC}"
    echo "  $target"

    if is_sme_file "$target"; then
        echo -e "${GREEN}Existing target appears to belong to showMeEverything.${NC}"
        return 0
    fi

    echo -e "${YELLOW}Existing target does not contain the SME signature.${NC}"

    read -r -p "Replace this file? [y/N] " answer

    case "$answer" in
        [Yy]*)
            return 0
            ;;
        *)
            echo -e "${RED}Installation cancelled to protect the existing file.${NC}"
            return 1
            ;;
    esac
}

# ============================================================
# Inspect existing installation
# ============================================================

inspect_targets() {

    check_target "$SMECLI_BIN"
    check_target "$SMECLI"
}

# ============================================================
# Check existing installation
# ============================================================

check_existing_installation() {

    if [ ! -e "$SMECLI_BIN" ] \
        && [ ! -e "$SMECLI" ] \
        && [ ! -d "$SMECLI_MODULE_DIR" ]
    then
        return 0
    fi

    echo
    echo -e "${YELLOW}An existing showMeEverything installation was detected.${NC}"

    if implementation_matches_repo; then
        echo -e "${GREEN}Installed implementation already matches the repository.${NC}"
        echo
        read -r -p "Reinstall it anyway? [y/N] " answer

        case "$answer" in
            [Yy]*)
                return 0
                ;;
            *)
                echo "Installation skipped."
                exit 0
                ;;
        esac
    fi

    echo -e "${YELLOW}The existing implementation differs from the repository.${NC}"
    read -r -p "Replace the existing installation? [Y/n] " answer

    case "$answer" in
        [Nn]*)
            echo "Installation cancelled."
            exit 0
            ;;
    esac
}

# ============================================================
# Clean previous SME installation
# ============================================================

clean_previous_install() {

    echo
    echo "Removing previous showMeEverything installation..."

    rm -f "$SMECLI_BIN"
    rm -f "$SMECLI"

    if [ -d "$SMECLI_MODULE_DIR" ]; then
        rm -rf "$SMECLI_MODULE_DIR"
    fi
}

# ============================================================
# Install CLI
# ============================================================

install_cli() {

    echo
    echo -e "${BLUE}Installing showMeEverything CLI...${NC}"

    mkdir -p "$(dirname "$SMECLI_BIN")"
    mkdir -p "$SMECLI_MODULE_DIR"

    # --------------------------------------------------------
    # Install modules
    # --------------------------------------------------------

    local module

    for module in "${SME_MODULES[@]}"; do

        cp "$SME_CLI_DIR/$module" \
            "$SMECLI_MODULE_DIR/$module"

        chmod 644 \
            "$SMECLI_MODULE_DIR/$module"

    done

    # --------------------------------------------------------
    # Install launcher
    # --------------------------------------------------------

    if [ -f "$SME_LAUNCHER_SRC" ]; then

        sed "1c\\#!$SME_SHEBANG" \
            "$SME_LAUNCHER_SRC" \
            > "$SMECLI_BIN"

        chmod 555 "$SMECLI_BIN"

    else

        echo -e "${RED}Launcher template missing: $SME_LAUNCHER_SRC${NC}"
        return 1

    fi

    # --------------------------------------------------------
    # smecli compatibility command
    # --------------------------------------------------------

    ln -sf "$SMECLI_BIN" "$SMECLI"

    echo -e "${GREEN}CLI installed successfully.${NC}"
}

# ============================================================
# Verify installation
# ============================================================

verify_installation() {

    echo
    echo -e "${BLUE}Verifying installation...${NC}"

    if [ ! -x "$SMECLI_BIN" ]; then
        echo -e "${RED}Executable missing:${NC}"
        echo "  $SMECLI_BIN"
        return 1
    fi

    if [ ! -L "$SMECLI" ] && [ ! -f "$SMECLI" ]; then
        echo -e "${RED}smecli command missing:${NC}"
        echo "  $SMECLI"
        return 1
    fi

    local module

    for module in "${SME_MODULES[@]}"; do

        if [ ! -f "$SMECLI_MODULE_DIR/$module" ]; then
            echo -e "${RED}Installed module missing:${NC}"
            echo "  $SMECLI_MODULE_DIR/$module"
            return 1
        fi

    done

    if ! implementation_matches_repo; then
        echo -e "${RED}Installed implementation does not match repository source.${NC}"
        return 1
    fi

    echo -e "${GREEN}Installation verified successfully.${NC}"

    echo
    echo "Executable:"
    echo "  $SMECLI_BIN"

    echo
    echo "Compatibility command:"
    echo "  $SMECLI"

    echo
    echo "Modules:"
    echo "  $SMECLI_MODULE_DIR"
}

# ============================================================
# Environment checks
# ============================================================

check_environment() {

    echo
    echo "Environment: $SME_ENVIRONMENT"

    case "$SME_ENVIRONMENT" in

        TERMUX)
            echo "Prefix:      $PREFIX"
            echo "Install bin: $SMECLI_BIN"
            echo "Module dir:  $SMECLI_MODULE_DIR"
            ;;

        LINUX)
            echo "Install bin: $SMECLI_BIN"
            echo "Module dir:  $SMECLI_MODULE_DIR"

            if [ "$EUID" -ne 0 ]; then
                echo
                echo -e "${RED}Linux installation requires root privileges.${NC}"
                echo "Run:"
                echo "  sudo $SCRIPT_DIR/install"
                exit 1
            fi
            ;;

        *)
            echo -e "${RED}Unsupported environment.${NC}"
            exit 1
            ;;

    esac
}

# ============================================================
# Main
# ============================================================

main() {

    detect_shell
    detect_environment
    define_paths

    echo
    echo "============================================================"
    echo " showMeEverything Installer"
    echo "============================================================"
    echo
    echo "Repository:"
    echo "  $SCRIPT_DIR"

    check_environment

    # --------------------------------------------------------
    # Repository validation
    # --------------------------------------------------------

    if ! check_cli_source; then

        echo
        echo -e "${RED}Repository validation failed.${NC}"
        echo
        read -r -p "Continue anyway? [y/N] " answer

        case "$answer" in
            [Yy]*)
                echo -e "${YELLOW}Continuing with an incomplete repository.${NC}"
                ;;
            *)
                exit 1
                ;;
        esac

    fi

    # --------------------------------------------------------
    # Determine install mode
    # --------------------------------------------------------

    determine_install_mode

    echo
    echo "Install mode: $INSTALL_MODE"

    if [ "$INSTALL_MODE" = "BROKEN" ]; then
        echo
        echo -e "${RED}Unable to determine a valid installation mode.${NC}"
        exit 1
    fi

    # --------------------------------------------------------
    # Dependency check
    # --------------------------------------------------------

    check_zsh

    # --------------------------------------------------------
    # Existing installation
    # --------------------------------------------------------

    inspect_targets
    check_existing_installation

    # --------------------------------------------------------
    # Replace previous installation
    # --------------------------------------------------------

    if [ -e "$SMECLI_BIN" ] \
        || [ -e "$SMECLI" ] \
        || [ -d "$SMECLI_MODULE_DIR" ]
    then
        clean_previous_install
    fi

    # --------------------------------------------------------
    # Install
    # --------------------------------------------------------

    install_cli

    # --------------------------------------------------------
    # Verify
    # --------------------------------------------------------

    verify_installation

    echo
    echo "============================================================"
    echo -e "${GREEN} showMeEverything installation complete.${NC}"
    echo "============================================================"
}

main "$@"
