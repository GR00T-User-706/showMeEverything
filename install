#!/usr/bin/env bash
set -e

# --- Colors for output ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# --- Global state ---
INSTALL_MODE=""
PYTHON_INSTALLED=0
QT_INSTALLED=0

# --- Detect shell and set SCRIPT_DIR ---
detect_shell() {
    if [ -n "$ZSH_VERSION" ]; then
        SCRIPT_DIR="${0:A:h}"
    elif [ -n "$BASH_VERSION" ]; then
        SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
    else
        echo -e "${RED}Unsupported shell. Only Bash and Zsh are supported.${NC}"
        exit 1
    fi
}

# --- Define paths ---
define_paths() {
    SMEICON_SRC="$SCRIPT_DIR/showmeeverything_gui/assets/showMeEverything.png"
    SMEICON="/usr/local/share/icons/showMeEverything.png"
    SMECLI_SRC="$SCRIPT_DIR/showMeEverything"
    SMECLI_BIN="/usr/local/bin/showMeEverything"
    SMECLI="/usr/local/bin/smecli"
    SMEGUID="/usr/local/share/applications/com.github.gr00t-user-706.showmeeverything-gui-qml.desktop"
    SMEGUID_SRC="$SCRIPT_DIR/showmeeverything_gui/assets/com.github.gr00t-user-706.showmeeverything-gui-qml.desktop"
    SMEGUI="/usr/local/bin/smegui"
    SMEGUI_BIN_OLD="/usr/local/bin/showmeeverything_gui"
    SMEGUI_BIN_NEW="/usr/local/bin/showmeeverything_qml"
    SMEGUI_SRC="$SCRIPT_DIR/showmeeverything_gui/showmeeverything_qml"
    SMEGPYD="/usr/local/share/applications/com.github.gr00t-user-706.showmeeverything-gui-python.desktop"
    SMEGPYD_SRC="$SCRIPT_DIR/showmeeverything_gui/assets/com.github.gr00t-user-706.showmeeverything-gui-python.desktop"
    SMEGPY_SRC="$SCRIPT_DIR/showmeeverything_gui/showmeeverything_tk.py"
    SMEGPY="/usr/local/bin/smegpy"
    SMEGPY_BIN="/usr/local/bin/showmeeverything_tk"
    GUI_DIR="$SCRIPT_DIR/showmeeverything_gui"
}

# --- Check root ---
check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}Please run as root (sudo ./install)${NC}"
        exit 1
    fi
}

# --- Header ---
show_header() {
    echo -e "${GREEN}Show Me Everything Installer${NC}"
    echo "----------------------------------------"
    echo "Core: CLI (required)"
    echo "Optional: Python/Tk GUI, Qt GUI"
    echo ""
}

# --- Determine install mode (GOLDEN GATE) ---
determine_install_mode() {
    if [ ! -d "$GUI_DIR" ]; then
        echo -e "${RED}FATAL: GUI source directory missing: $GUI_DIR${NC}"
        echo -e "${RED}This install is incomplete or not a full repository clone.${NC}"
        echo ""
        echo -e "${YELLOW}Only the CLI can be installed at this time.${NC}"
        echo -e "${YELLOW}The GUI components (Qt + Tk) and desktop entries will be skipped.${NC}"
        echo ""

        read -rp "Continue with CLI-only installation? [y/N]: " CONTINUE_CLI_ONLY

        case "$CONTINUE_CLI_ONLY" in
            [yY]|[yY][eE][sS])
                echo -e "${YELLOW}Proceeding with CLI-only installation...${NC}"
                INSTALL_MODE="cli_only"
                ;;
            *)
                echo "Installation aborted."
                exit 0
                ;;
        esac
    else
        INSTALL_MODE="full"
        echo -e "${GREEN}Full repository detected - will attempt all components.${NC}"
    fi
}

# --- Check existing installation ---
check_existing_installation() {
    if [ ! -f "${SMECLI_SRC}" ]; then
        echo -e "${RED}ERROR: CLI core not found. Aborting.${NC}"
        exit 1
    fi

    EXISTING_CLI="${SMECLI_BIN}"
    NEW_CLI="$SMECLI_SRC"

    if [ -f "$EXISTING_CLI" ]; then
        echo -e "${YELLOW}Existing binary detected at $SMECLI_BIN.${NC}"

        IS_OURS=0
        SAME_HASH=0

        if grep -q "SME_SIGNATURE=gr00t-user-706" "$EXISTING_CLI" 2>/dev/null; then
            IS_OURS=1
            echo -e "${GREEN}Recognized as Show Me Everything installation.${NC}"
        else
            echo -e "${YELLOW}WARNING: Existing file is NOT recognized as this project.${NC}"
        fi

        if command -v sha256sum >/dev/null 2>&1; then
            EXISTING_HASH=$(sha256sum "$EXISTING_CLI" | awk '{print $1}')
            NEW_HASH=$(sha256sum "$NEW_CLI" | awk '{print $1}')

            if [ "$EXISTING_HASH" = "$NEW_HASH" ]; then
                SAME_HASH=1
                echo -e "${GREEN}Binary is identical to this version.${NC}"
            else
                echo -e "${YELLOW}Binary differs from this version.${NC}"
            fi
        else
            echo -e "${YELLOW}sha256sum not available – skipping hash comparison.${NC}"
        fi

        echo ""

        if [ $IS_OURS -eq 1 ] && [ $SAME_HASH -eq 1 ]; then
            read -rp "Same version already installed. Reinstall anyway? [y/N]: " CONFIRM
        elif [ $IS_OURS -eq 1 ]; then
            read -rp "Update existing Show Me Everything installation? [Y/n]: " CONFIRM
        else
            read -rp "Overwrite unknown binary at this path? [y/N]: " CONFIRM
        fi

        case "$CONFIRM" in
            [yY]|[yY][eE][sS])
                echo "Continuing installation..."
                ;;
            *)
                echo "Installation aborted."
                exit 0
                ;;
        esac
    fi
}

# --- Clean previous installation ---
clean_previous_install() {
    echo -e "${YELLOW}Cleaning previous installation...${NC}"

    rm -f "$SMECLI_BIN"
    rm -f "$SMECLI"
    rm -f "$SMEGPY_BIN"
    rm -f "$SMEGPY"
    rm -f "$SMEGUI_BIN_OLD" "$SMEGUI_BIN_NEW"
    rm -f "$SMEGUI"
    rm -f "$SMEGUID"
    rm -f "$SMEGPYD"
    rm -f "$SMEICON"
}

# --- Install CLI (ALWAYS runs) ---
install_cli() {
    echo -e "${GREEN}[CLI] Installing core...${NC}"

    mkdir -p /usr/local/share/icons/
    mkdir -p /usr/local/share/applications/

    install -m 555 "$SMECLI_SRC" "$SMECLI_BIN"
    ln -sf "$SMECLI_BIN" "$SMECLI"

    echo -e "${GREEN}CLI installed successfully.${NC}"
}

# --- Check and prep Python GUI ---
check_python_gui() {
    PYTHON_TK_OK=0

    echo -e "${GREEN}[Python GUI] Checking dependencies...${NC}"

    if command -v python3 >/dev/null 2>&1; then
        if python3 -c "import tkinter" >/dev/null 2>&1; then
            PYTHON_TK_OK=1
            echo "Python + tkinter detected."
        else
            echo -e "${YELLOW}python3 found but tkinter missing.${NC}"
        fi
    else
        echo -e "${YELLOW}python3 not found.${NC}"
    fi
}

# --- Install Python GUI ---
install_python_gui() {
    echo "Installing Python GUI..."
    install -m 555 "$SMEGPY_SRC" "$SMEGPY_BIN"
    ln -sf "$SMEGPY_BIN" "$SMEGPY"
    PYTHON_INSTALLED=1
}

# --- Check and prep Qt GUI ---
check_qt_gui() {
    QT_DEPS_OK=1
    QT_BUILD_OK=0

    echo -e "${GREEN}[Qt GUI] Checking dependencies...${NC}"

    if ! command -v qmake6 >/dev/null 2>&1; then
        echo -e "${YELLOW}qmake6 not found.${NC}"
        QT_DEPS_OK=0
    fi

    if ! command -v make >/dev/null 2>&1; then
        echo -e "${YELLOW}make not found.${NC}"
        QT_DEPS_OK=0
    fi
}

# --- Build Qt GUI ---
build_qt_gui() {
    if [ "$QT_DEPS_OK" -eq 1 ]; then
        echo "Attempting Qt build..."

        cd "$SCRIPT_DIR/showmeeverything_gui"

        rm -f Makefile qrc_resources.cpp moc_*.cpp *.o showmeeverything_gui showmeeverything_qml 2>/dev/null || true

        if qmake6 showmeeverything_gui.pro && make; then
            QT_BUILD_OK=1
            echo -e "${GREEN}Qt GUI built successfully.${NC}"
        else
            echo -e "${YELLOW}Qt build failed.${NC}"
        fi

        cd "$SCRIPT_DIR"
    else
        echo -e "${YELLOW}Skipping Qt build due to missing dependencies.${NC}"
    fi
}

# --- Install Qt GUI ---
install_qt_gui() {
    if [ "$QT_BUILD_OK" -eq 1 ] && [ -f "$SMEGUI_SRC" ]; then
        echo "Installing Qt GUI..."
        install -m 555 "$SMEGUI_SRC" "$SMEGUI_BIN_NEW"
        ln -sf "$SMEGUI_BIN_NEW" "$SMEGUI"
        QT_INSTALLED=1
    else
        echo -e "${YELLOW}Skipping Qt GUI installation.${NC}"
    fi
}

# --- Install desktop entries and icons ---
install_desktop_entries() {
    echo -e "${GREEN}[Desktop] Installing entries...${NC}"

    # Install icon if it exists
    if [ -f "$SMEICON_SRC" ]; then
        install -m 644 "$SMEICON_SRC" "$SMEICON"
    else
        echo -e "${YELLOW}Icon source missing - skipping icon installation${NC}"
    fi

    # Install Qt desktop entry if Qt GUI was installed
    if [ "$QT_INSTALLED" -eq 1 ] && [ -f "$SMEGUID_SRC" ]; then
        install -m 644 "$SMEGUID_SRC" /usr/local/share/applications/
    elif [ "$INSTALL_MODE" = "full" ]; then
        echo -e "${YELLOW}Skipping Qt desktop entry (Qt GUI not installed).${NC}"
    fi

    # Install Python desktop entry if Python GUI was installed
    if [ "$PYTHON_INSTALLED" -eq 1 ] && [ -f "$SMEGPYD_SRC" ]; then
        install -m 644 "$SMEGPYD_SRC" /usr/local/share/applications/
    elif [ "$INSTALL_MODE" = "full" ]; then
        echo -e "${YELLOW}Skipping Python desktop entry (Python GUI not installed).${NC}"
    fi

    # Update desktop database if available
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database
    fi
}

set_ownership() {
    chown -R "$SUDO_USER":"$SUDO_USER" "$SCRIPT_DIR"
}

# --- Show summary based on install mode ---
show_summary() {
    echo ""
    echo "========== INSTALL SUMMARY =========="

    case "$INSTALL_MODE" in
        cli_only)
            echo "Mode: CLI-ONLY (repository incomplete)"
            echo "CLI: INSTALLED ✓"
            echo "Python GUI: SKIPPED (missing GUI directory)"
            echo "Qt GUI: SKIPPED (missing GUI directory)"
            echo ""
            echo -e "${YELLOW}What you can do:${NC}"
            echo "  • CLI is fully functional at 'smecli' or 'showMeEverything'"
            echo "  • To get GUI components, clone the complete repository with:"
            echo "    git clone <full-repo-url> (includes showmeeverything_gui/)"
            echo "  • Then re-run 'sudo ./install' to add GUI features"
            ;;
        full)
            echo "Mode: FULL (complete repository)"
            echo "CLI: INSTALLED ✓"

            if [ "$PYTHON_INSTALLED" -eq 1 ]; then
                echo "Python GUI: INSTALLED ✓"
            else
                echo "Python GUI: SKIPPED ✗"
                echo "  → Missing: python3 or tkinter"
                echo "  → Fix: sudo apt install python3-tk (Debian/Ubuntu)"
                echo "      or sudo dnf install python3-tkinter (Fedora)"
            fi

            if [ "$QT_INSTALLED" -eq 1 ]; then
                echo "Qt GUI: INSTALLED ✓"
            else
                echo "Qt GUI: SKIPPED ✗"
                echo "  → Missing: qmake6 or make"
                echo "  → Fix: sudo apt install qt6-base-dev make (Debian/Ubuntu)"
                echo "      or sudo dnf install qt6-qtbase-devel make (Fedora)"
            fi
            ;;
    esac

    echo "===================================="
    echo ""
    echo -e "${GREEN}Installation complete!${NC}"

    if [ "$INSTALL_MODE" = "cli_only" ]; then
        echo -e "${YELLOW}Remember: Run this installer again from the full repo to get GUI features.${NC}"
    fi
}

# --- Main execution flow using case statement ---
main() {
    # Setup phase (always runs)
    detect_shell
    define_paths
    check_root
    show_header

    # Gate phase (determines install mode)
    determine_install_mode

    # Pre-installation phase (always runs)
    check_existing_installation
    clean_previous_install

    # Installation phase based on mode
    case "$INSTALL_MODE" in
        cli_only)
            # CLI only - install just the core
            install_cli
            ;;

        full)
            # Full install - attempt everything
            install_cli

            # Python GUI
            check_python_gui
            if [ $PYTHON_TK_OK -eq 1 ]; then
                install_python_gui
            fi

            # Qt GUI
            check_qt_gui
            build_qt_gui
            install_qt_gui

            # Desktop entries (only if at least one GUI installed or icon exists)
            install_desktop_entries
            ;;
    esac
    set_ownership
    # Summary phase (always runs)
    show_summary
}

# --- Run the main function ---
main
