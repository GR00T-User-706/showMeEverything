#!/usr/bin/env bash
# SME_SIGNATURE=gr00t-user--706

set -e

# ============================================================
# showMeEverything Unified CLI Installer
# Bash / Zsh compatible
# ============================================================

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# --- Installer identity ---
readonly SME_SIGNATURE="gr00t-user--706"

# --- Global state ---
SME_ENVIRONMENT=""
SME_SHEBANG=""
SME_ENTRYPOINT=""
SME_PKG_MANAGER=""

SME_CLI_DIR=""
SME_CLI_SRC=""
SME_LAUNCHER_SRC=""

SMECLI_BIN=""
SMECLI=""
SMECLI_MODULE_DIR=""

INSTALL_MODE=""
SCRIPT_DIR=""

# ============================================================
# Constants
# ============================================================

readonly SME_LINUX="/usr/bin/env zsh"
readonly SME_TERMUX="${PREFIX:-}/bin/env zsh"

readonly SME_MODULES=(
    "showMeEverything.zsh"
    "config.zsh"
    "shell_searches.zsh"
    "package_manager_searches.zsh"
    "filesystem_searches.zsh"
    "help.zsh"
)

# ============================================================
# Portable input helper
# ============================================================

prompt() {
    local message="$1"
    local answer=""

    printf "%s" "$message"
    IFS= read -r answer
    printf '%s' "$answer"
}

# ============================================================
# Detect installer location
# ============================================================

detect_shell() {
    if [ -n "${ZSH_VERSION:-}" ]; then
        SCRIPT_DIR="${0:A:h}"
        return
    fi

    if [ -n "${BASH_VERSION:-}" ]; then
        SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
        return
    fi

    echo -e "${RED}Unsupported shell. Run this installer with Bash or Zsh.${NC}"
    exit 1
}

# ============================================================
# Detect environment
# ============================================================

detect_environment() {
    local os
    os="$(uname -s 2>/dev/null || true)"

    # --------------------------------------------------------
    # Termux
    # --------------------------------------------------------

    if [ "$os" = "Linux" ] \
        && [ -n "${PREFIX:-}" ] \
        && [ -d "${PREFIX:-/nonexistent}" ] \
        && [ -d "${PREFIX:-/nonexistent}/bin" ] \
        && {
            [ -n "${TERMUX_VERSION:-}" ] ||
            [ -n "${TERMUX_APK_RELEASE:-}" ] ||
            [[ "${PREFIX:-}" == /data/data/*/files/usr ]]
        }
    then
        SME_ENVIRONMENT="TERMUX"
        SME_SHEBANG="$SME_TERMUX"
        return
    fi

    # --------------------------------------------------------
    # Linux
    # --------------------------------------------------------

    if [ "$os" = "Linux" ]; then
        SME_ENVIRONMENT="LINUX"
        SME_SHEBANG="$SME_LINUX"
        return
    fi

    SME_ENVIRONMENT="UNSUPPORTED"
}

# ============================================================
# Define paths
# ============================================================

define_paths() {
    SME_CLI_DIR="$SCRIPT_DIR/src"
    SME_CLI_SRC="$SME_CLI_DIR/showMeEverything.zsh"
    SME_LAUNCHER_SRC="$SME_CLI_DIR/showMeEverything.launcher"

    if [ "$SME_ENVIRONMENT" = "TERMUX" ]; then
        SMECLI_BIN="$PREFIX/bin/showMeEverything"
        SMECLI="$PREFIX/bin/smecli"
        SMECLI_MODULE_DIR="$PREFIX/lib/showMeEverything"
        SME_ENTRYPOINT="$SMECLI_MODULE_DIR/showMeEverything.zsh"
    else
        SMECLI_BIN="/usr/local/bin/showMeEverything"
        SMECLI="/usr/local/bin/smecli"
        SMECLI_MODULE_DIR="/usr/local/lib/showMeEverything"
        SME_ENTRYPOINT="$SMECLI_MODULE_DIR/showMeEverything.zsh"
    fi
}

# ============================================================
# Repository validation
# ============================================================

module_signature_variable() {
    case "$1" in
        showMeEverything.zsh) printf '%s\n' 'SME_SIGNATURE' ;;
        config.zsh) printf '%s\n' 'SME_SIG_CONFIG' ;;
        shell_searches.zsh) printf '%s\n' 'SME_SIG_SHELL' ;;
        package_manager_searches.zsh) printf '%s\n' 'SME_SIG_PKGMAN' ;;
        filesystem_searches.zsh) printf '%s\n' 'SME_SIG_FILESYSTEM' ;;
        help.zsh) printf '%s\n' 'SME_SIG_HELP' ;;
        showMeEverything.launcher) printf '%s\n' 'SME_SIG_LAUNCHER' ;;
        *) return 1 ;;
    esac
}

module_signature_value() {
    case "$1" in
        showMeEverything.zsh|config.zsh|shell_searches.zsh|package_manager_searches.zsh|filesystem_searches.zsh|help.zsh|showMeEverything.launcher)
            printf '%s\n' "$SME_SIGNATURE"
            ;;
        *) return 1 ;;
    esac
}

is_sme_file() {
    local file="$1"
    local signature_variable="$2"
    local signature_value="$3"

    [ -f "$file" ] || return 1

    grep -qE "^[[:space:]]*readonly[[:space:]]+${signature_variable}=\"${signature_value}\"[[:space:]]*$" \
        "$file" 2>/dev/null
}

check_cli_source() {
    echo
    echo -e "${BLUE}Checking showMeEverything source tree...${NC}"

    if [ ! -d "$SME_CLI_DIR" ]; then
        echo -e "${RED}Missing source directory:${NC}"
        echo "  $SME_CLI_DIR"
        return 1
    fi

    local missing=0
    local module
    local file
    local sig_var
    local sig_value

    for module in "${SME_MODULES[@]}"; do
        file="$SME_CLI_DIR/$module"
        sig_var="$(module_signature_variable "$module")"
        sig_value="$(module_signature_value "$module")"

        if [ ! -f "$file" ]; then
            echo -e "${RED}Missing CLI source file: $file${NC}"
            missing=1
            continue
        fi

        if ! is_sme_file "$file" "$sig_var" "$sig_value"; then
            echo -e "${RED}Missing or invalid SME signature: $file${NC}"
            missing=1
        fi
    done

    if [ ! -f "$SME_LAUNCHER_SRC" ]; then
        echo -e "${RED}Missing launcher: $SME_LAUNCHER_SRC${NC}"
        missing=1
    elif ! is_sme_file "$SME_LAUNCHER_SRC" "SME_SIG_LAUNCHER" "$SME_SIGNATURE"; then
        echo -e "${RED}Missing or invalid launcher signature: $SME_LAUNCHER_SRC${NC}"
        missing=1
    fi

    if [ "$missing" -ne 0 ]; then
        echo
        echo -e "${RED}The CLI source tree is incomplete or has invalid signatures.${NC}"
        return 1
    fi

    echo -e "${GREEN}CLI source tree is complete and signatures are valid.${NC}"
}

# ============================================================
# Determine installation mode
# ============================================================

determine_install_mode() {
    if [ "$SME_ENVIRONMENT" = "UNSUPPORTED" ]; then
        INSTALL_MODE="BROKEN"
        return
    fi

    if [ ! -f "$SME_CLI_SRC" ]; then
        INSTALL_MODE="BROKEN"
        return
    fi

    case "$SME_ENVIRONMENT" in
        TERMUX) INSTALL_MODE="TERMUX" ;;
        LINUX) INSTALL_MODE="LINUX_CLI" ;;
        *) INSTALL_MODE="BROKEN" ;;
    esac
}

# ============================================================
# Package manager detection
# ============================================================

detect_package_manager() {
    SME_PKG_MANAGER=""

    if [ "$SME_ENVIRONMENT" = "TERMUX" ] && command -v pkg >/dev/null 2>&1; then
        SME_PKG_MANAGER="pkg"
        return
    fi

    if command -v apt-get >/dev/null 2>&1; then
        SME_PKG_MANAGER="apt-get"
        return
    fi

    if command -v dnf >/dev/null 2>&1; then
        SME_PKG_MANAGER="dnf"
        return
    fi

    if command -v pacman >/dev/null 2>&1; then
        SME_PKG_MANAGER="pacman"
        return
    fi

    if command -v zypper >/dev/null 2>&1; then
        SME_PKG_MANAGER="zypper"
        return
    fi

    if command -v apk >/dev/null 2>&1; then
        SME_PKG_MANAGER="apk"
    fi
}

install_dependency() {
    local package_name="$1"
    local package="$2"
    local answer=""

    echo
    echo -e "${YELLOW}$package_name is required but is not installed.${NC}"
    answer="$(prompt "Install it now? [Y/n] ")"

    case "$answer" in
        [Nn]*)
            echo -e "${RED}Cannot continue without $package_name.${NC}"
            return 1
            ;;
    esac

    case "$SME_PKG_MANAGER" in
        apt-get) apt-get update && apt-get install -y "$package" ;;
        dnf) dnf install -y "$package" ;;
        pacman) pacman -Sy --noconfirm --needed "$package" ;;
        zypper) zypper --non-interactive install "$package" ;;
        apk) apk add "$package" ;;
        pkg) pkg install -y "$package" ;;
        *)
            echo -e "${RED}No supported package manager was detected.${NC}"
            return 1
            ;;
    esac
}

# ============================================================
# Check Zsh
# ============================================================

check_zsh() {
    if command -v zsh >/dev/null 2>&1; then
        echo -e "${GREEN}Zsh detected: $(command -v zsh)${NC}"
        return 0
    fi

    echo -e "${YELLOW}Zsh was not found.${NC}"
    detect_package_manager

    if [ -z "$SME_PKG_MANAGER" ]; then
        echo -e "${RED}Unable to determine a package manager.${NC}"
        return 1
    fi

    echo "Package manager: $SME_PKG_MANAGER"
    install_dependency "Zsh" "zsh" || return 1

    if command -v zsh >/dev/null 2>&1; then
        echo -e "${GREEN}Zsh installed successfully.${NC}"
        return 0
    fi

    echo -e "${RED}Zsh installation completed, but Zsh could not be found afterward.${NC}"
    return 1
}

# ============================================================
# Target ownership / integrity helpers
# ============================================================

check_target_state() {
    local target="$1"
    local source="$2"
    local sig_var="$3"
    local sig_value="$4"
    local source_hash
    local target_hash
    local answer=""

    [ -e "$target" ] || return 0

    echo
    echo -e "${YELLOW}Existing target detected:${NC}"
    echo "  $target"

    # Symlinks are handled separately because the target's contents are
    # not necessarily the source file that the installer owns.
    if [ -L "$target" ]; then
        echo "  Existing target is a symlink to: $(readlink "$target")"
        return 2
    fi

    if is_sme_file "$target" "$sig_var" "$sig_value"; then
        echo -e "${GREEN}Existing target belongs to showMeEverything.${NC}"

        if command -v sha256sum >/dev/null 2>&1; then
            target_hash="$(sha256sum "$target" | awk '{print $1}')"
            source_hash="$(sha256sum "$source" | awk '{print $1}')"

            if [ "$target_hash" = "$source_hash" ]; then
                echo -e "${GREEN}Installed file matches repository source.${NC}"
                return 0
            fi

            echo -e "${YELLOW}Installed file differs from repository source.${NC}"
            answer="$(prompt "Update this SME file? [Y/n] ")"
            case "$answer" in
                [Nn]*)
                    echo "Installation cancelled."
                    return 1
                    ;;
            esac
            return 0
        fi

        echo -e "${YELLOW}sha256sum is unavailable; ownership verified but integrity could not be checked.${NC}"
        answer="$(prompt "Proceed with replacing this SME file? [y/N] ")"
        case "$answer" in
            [Yy]*) return 0 ;;
            *) return 1 ;;
        esac
    fi

    echo -e "${RED}WARNING: Existing target does not have the expected SME signature.${NC}"
    echo -e "${YELLOW}Inspect this file before allowing a destructive replacement:${NC}"
    echo "  $target"
    answer="$(prompt "Replace this unknown file? [y/N] ")"

    case "$answer" in
        [Yy]*) return 0 ;;
        *)
            echo -e "${RED}Installation cancelled to protect the existing file.${NC}"
            return 1
            ;;
    esac
}

# ============================================================
# Inspect existing installation
# ============================================================

inspect_targets() {
    local module
    local source
    local target
    local sig_var
    local rc

    # Main launcher target.
    check_target_state \
        "$SMECLI_BIN" \
        "$SME_LAUNCHER_SRC" \
        "SME_SIG_LAUNCHER" \
        "$SME_SIGNATURE"
    rc=$?
    [ "$rc" -eq 0 ] || return "$rc"

    # Actual implementation and modules.
    for module in "${SME_MODULES[@]}"; do
        source="$SME_CLI_DIR/$module"
        target="$SMECLI_MODULE_DIR/$module"
        sig_var="$(module_signature_variable "$module")"

        check_target_state "$target" "$source" "$sig_var" "$SME_SIGNATURE"
        rc=$?
        [ "$rc" -eq 0 ] || return "$rc"
    done

    # smecli is a compatibility symlink and is deliberately not treated as
    # a module or source file. It must point at showMeEverything.
    if [ -e "$SMECLI" ] || [ -L "$SMECLI" ]; then
        echo
        echo -e "${YELLOW}Existing compatibility command detected:${NC}"
        echo "  $SMECLI"
        if [ -L "$SMECLI" ]; then
            echo "  Current target: $(readlink "$SMECLI")"
        else
            echo -e "${RED}WARNING: $SMECLI exists and is not a symlink.${NC}"
            echo -e "${YELLOW}It should be the SME compatibility symlink to showMeEverything.${NC}"
            local answer=""
            answer="$(prompt "Replace it with the correct symlink? [y/N] ")"
            case "$answer" in
                [Yy]*) ;;
                *) return 1 ;;
            esac
        fi
    fi
}

# ============================================================
# Install CLI without unnecessary overwrites
# ============================================================

install_cli() {
    echo
    echo -e "${BLUE}Installing showMeEverything CLI...${NC}"

    local module
    local source
    local target
    local sig_var
    local source_hash
    local target_hash
    local launcher_tmp

    # --------------------------------------------------------
    # Install/update modules only when they are missing or differ.
    # --------------------------------------------------------

    for module in "${SME_MODULES[@]}"; do
        source="$SME_CLI_DIR/$module"
        target="$SMECLI_MODULE_DIR/$module"
        sig_var="$(module_signature_variable "$module")"

        if [ -f "$target" ] \
            && is_sme_file "$target" "$sig_var" "$SME_SIGNATURE" \
            && [ -f "$source" ] \
            && source_hash="$(sha256sum "$source" | awk '{print $1}')" \
            && target_hash="$(sha256sum "$target" | awk '{print $1}')" \
            && [ "$source_hash" = "$target_hash" ]
        then
            echo -e "${GREEN}[UNCHANGED]${NC} $target"
            continue
        fi

        echo "Installing: $target"
	install -D -m 644 "$source" "$target"
    done

    # --------------------------------------------------------
    # Generate the environment-specific launcher in a temporary
    # file first, then replace the installed launcher only when
    # its generated contents differ.
    # --------------------------------------------------------

    launcher_tmp="$(mktemp)"

    sed \
        -e "1c\\#!$SME_SHEBANG" \
        -e "s|^exec __SME_ENTRYPOINT__ \"\$@\"$|exec \"$SME_ENTRYPOINT\" \"\$@\"|" \
        "$SME_LAUNCHER_SRC" > "$launcher_tmp"

    chmod 555 "$launcher_tmp"

    if [ -f "$SMECLI_BIN" ] \
        && is_sme_file "$SMECLI_BIN" "SME_SIG_LAUNCHER" "$SME_SIGNATURE" \
        && [ "$(sha256sum "$SMECLI_BIN" | awk '{print $1}')" = "$(sha256sum "$launcher_tmp" | awk '{print $1}')" ]
    then
        echo -e "${GREEN}[UNCHANGED]${NC} $SMECLI_BIN"
    else
        install -D -m 555 "$launcher_tmp" "$SMECLI_BIN"
        echo "Installed: $SMECLI_BIN"
    fi

    rm -f "$launcher_tmp"

    # --------------------------------------------------------
    # smecli is always the compatibility symlink to showMeEverything.
    # --------------------------------------------------------

    if [ -L "$SMECLI" ] && [ "$(readlink "$SMECLI")" = "$SMECLI_BIN" ]; then
        echo -e "${GREEN}[UNCHANGED]${NC} $SMECLI -> $SMECLI_BIN"
    else
        rm -f "$SMECLI"
        ln -s "$SMECLI_BIN" "$SMECLI"
        echo "Installed symlink: $SMECLI -> $SMECLI_BIN"
    fi

    echo -e "${GREEN}CLI installation/update complete.${NC}"
}

# ============================================================
# Verify installation
# ============================================================

verify_installation() {
    echo
    echo -e "${BLUE}Verifying installation...${NC}"

    if [ ! -x "$SMECLI_BIN" ]; then
        echo -e "${RED}Executable missing:${NC}"
        echo "  $SMECLI_BIN"
        return 1
    fi

    if [ ! -L "$SMECLI" ]; then
        echo -e "${RED}smecli is not the required symlink:${NC}"
        echo "  $SMECLI"
        return 1
    fi

    if [ "$(readlink "$SMECLI")" != "$SMECLI_BIN" ]; then
        echo -e "${RED}smecli points to the wrong target:${NC}"
        echo "  $(readlink "$SMECLI")"
        return 1
    fi

    local module
    local source_hash
    local installed_hash

    for module in "${SME_MODULES[@]}"; do
        if [ ! -f "$SMECLI_MODULE_DIR/$module" ]; then
            echo -e "${RED}Installed module missing:${NC}"
            echo "  $SMECLI_MODULE_DIR/$module"
            return 1
        fi

        if ! is_sme_file "$SMECLI_MODULE_DIR/$module" "$(module_signature_variable "$module")" "$SME_SIGNATURE"; then
            echo -e "${RED}Installed module has an invalid SME signature:${NC}"
            echo "  $SMECLI_MODULE_DIR/$module"
            return 1
        fi

        source_hash="$(sha256sum "$SME_CLI_DIR/$module" | awk '{print $1}')"
        installed_hash="$(sha256sum "$SMECLI_MODULE_DIR/$module" | awk '{print $1}')"

        if [ "$source_hash" != "$installed_hash" ]; then
            echo -e "${RED}Installed module does not match repository source:${NC}"
            echo "  $module"
            return 1
        fi
    done

    if ! is_sme_file "$SMECLI_BIN" "SME_SIG_LAUNCHER" "$SME_SIGNATURE"; then
        echo -e "${RED}Installed launcher has an invalid SME signature.${NC}"
        return 1
    fi

    if ! grep -Fq "exec \"$SME_ENTRYPOINT\" \"\$@\"" "$SMECLI_BIN"; then
        echo -e "${RED}Installed launcher points to the wrong implementation path.${NC}"
        echo "  Expected: $SME_ENTRYPOINT"
        return 1
    fi

    echo -e "${GREEN}Installation files verified successfully.${NC}"

    echo
    echo "Executable:"
    echo "  $SMECLI_BIN"

    echo
    echo "Compatibility command:"
    echo "  $SMECLI"

    echo
    echo "Implementation:"
    echo "  $SME_ENTRYPOINT"

    echo
    echo "Modules:"
    echo "  $SMECLI_MODULE_DIR"
}

# ============================================================
# Runtime verification
# ============================================================

verify_runtime() {
    echo
    echo -e "${BLUE}Testing installed runtime...${NC}"

    local output
    if ! output="$("$SMECLI_BIN" --help 2>&1)"; then
        echo -e "${RED}Installed CLI failed its runtime test.${NC}"
        printf '%s\n' "$output"
        return 1
    fi

    if ! printf '%s\n' "$output" | grep -q 'smecli — Show Me Everything CLI'; then
        echo -e "${RED}Installed CLI did not produce expected help output.${NC}"
        printf '%s\n' "$output"
        return 1
    fi

    echo -e "${GREEN}Installed CLI runtime test passed.${NC}"
}

# ============================================================
# Environment checks
# ============================================================

check_environment() {
    echo
    echo "Environment: $SME_ENVIRONMENT"

    case "$SME_ENVIRONMENT" in
        TERMUX)
            echo "Prefix:      $PREFIX"
            echo "Install bin: $SMECLI_BIN"
            echo "Module dir:  $SMECLI_MODULE_DIR"
            ;;

        LINUX)
            echo "Install bin: $SMECLI_BIN"
            echo "Module dir:  $SMECLI_MODULE_DIR"

            if [ "$EUID" -ne 0 ]; then
                echo
                echo -e "${RED}Linux installation requires root privileges.${NC}"
                echo "Run:"
                echo "  sudo $SCRIPT_DIR/install"
                exit 1
            fi
            ;;

        *)
            echo -e "${RED}Unsupported environment.${NC}"
            exit 1
            ;;
    esac
}

# ============================================================
# Main
# ============================================================

main() {
    detect_shell
    detect_environment
    define_paths

    echo
    echo "============================================================"
    echo " showMeEverything Installer"
    echo "============================================================"
    echo
    echo "Repository:"
    echo "  $SCRIPT_DIR"

    check_environment

    if ! check_cli_source; then
        echo
        echo -e "${RED}Repository validation failed.${NC}"
        local answer=""
        answer="$(prompt "Continue anyway? [y/N] ")"

        case "$answer" in
            [Yy]*)
                echo -e "${YELLOW}Continuing with an incomplete or invalid repository.${NC}"
                ;;
            *)
                exit 1
                ;;
        esac
    fi

    determine_install_mode

    echo
    echo "Install mode: $INSTALL_MODE"

    if [ "$INSTALL_MODE" = "BROKEN" ]; then
        echo
        echo -e "${RED}Unable to determine a valid installation mode.${NC}"
        exit 1
    fi

    check_zsh

    # Existing files are inspected before any destructive operation.
    # If every existing SME-owned file matches, clean/install is still safe.
    inspect_targets

    install_cli
    verify_installation
    verify_runtime

    echo
    echo "============================================================"
    echo -e "${GREEN} showMeEverything installation complete.${NC}"
    echo "============================================================"
}

main "$@"
