SME_VERSION="v1.0.1"
# GLOBAL CONFIG DEFAULT STATE
# VALID STATES:
# PIPE_MODE=0 COLOR_MODE=1  -> human readable ANSI output
# PIPE_MODE=1 COLOR_MODE=0  -> machine parseable output
# any other combination is invalid and fatal
