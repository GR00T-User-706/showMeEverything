search() {
    local pattern=""
    local -a actions=()
    local use_less=false
    local exclude_dotfiles=false
    local has_ALL=false
    local has_all=false
    local has_system=false
    local original_args=("$@")
    if [ "${SMECLI_GUI_MODE:-0}" -eq 1 ]; then
        PIPE_MODE=1
    fi

    while [ $# -gt 0 ]; do
        case "$1" in
            --excludeDotFiles | --nodot) exclude_dotfiles=true ;;
            --less) use_less=true ;;
            --pipe | pipe )
                PIPE_MODE=1
                COLOR_MODE=0
                HEADER=0
                FOOTER=0
            ;;
            --glob|glob) REGEX=0 ;;
            -v|--version) echo "\$SME_VERSION: #$SME_VERSION" \  echo "\$SME_SIGNATURE: $SME_SIGNATURE" \ ;;


            --ALL | ALL | -A | A )
                actions+=(
                    search_path
                    search_loaded_commands
                    search_builtins
                    search_aliases
                    search_shell_functions
                    search_manpages
                    search_systemd_units
                    search_running_processes
                    loaded_kernel_modules
                    search_package_repo
                    search_installed_packages
                    search_package_files_db
                    search_packages_not_installed
                    search_home_directory
                    search_system_dirs
                )
                ;;

            --all | all )
                actions+=(
                    search_path
                    search_loaded_commands
                    search_builtins
                    search_aliases
                    search_shell_functions
                    search_manpages
                    search_running_processes
                    search_package_repo
                    search_installed_packages
                    search_package_files_db
                    search_packages_not_installed
                    search_home_directory
                )
                ;;

            --aliases | aliases | -a | a) actions+=(search_aliases) ;;
            --bin | bin ) actions+=(search_bin) ;;
            --boot | boot | -B | B ) actions+=(search_boot) ;;
            --builtins | builtins | -b | b) actions+=(search_builtins) ;;
            --command | command | -c | c) actions+=(search_loaded_commands) ;;
            --etc | etc | -E | E ) actions+=(search_etc) ;;
            --files | files | -F | F ) actions+=(search_package_files_db) ;;
            --functions | functions | -f | f ) actions+=(search_shell_functions) ;;
            --home | home | -H | H ) actions+=(search_home_directory) ;;
            --installed | installed | -i | i ) actions+=(search_installed_packages) ;;
            --lib | lib | -L | L ) actions+=(search_lib) ;;
            --manpages | manpages | --man | man | -M | M ) actions+=(search_manpages) ;;
            --modules | modules | -m | m) actions+=(loaded_kernel_modules) ;;
            --not-installed | not-installed | -n | n ) actions+=(search_packages_not_installed) ;;
            --process | process | -x | x ) actions+=(search_running_processes) ;;
            --packages | packages | -p | p | --pkg | pkg) actions+=(search_package_repo) ;;
            --path | path | -P | P ) actions+=(search_path) ;;
            --sbin | sbin ) actions+=(search_sbin) ;;
            --systemd | systemd | -s | s ) actions+=(search_systemd_units) ;;
            --system | system | -R | R ) actions+=(search_system_dirs) ;;
            --usr | usr | -U | U ) actions+=(search_usr) ;;
            --var | var | -V | V ) actions+=(search_var) ;;
            --opt | opt | -O | O ) actions+=(search_opt) ;;

            --help | -h | help | h ) help; return ;;
            *)
                pattern="$1"
                ;;
        esac
        shift
    done

    for arg in "${original_args[@]}"; do
        case "$arg" in
            --ALL|ALL|-A|A) has_ALL=true ;;
            --all|all) has_all=true ;;
            --system|system|-R|R) has_system=true ;;
        esac
    done
    if { [ "$has_ALL" = true ] && [ "$has_all" = true ]; } || \
       { [ "$has_ALL" = true ] && [ "$has_system" = true ]; } || \
       { [  "$has_all" = true ] && [ "$has_system" = true ]; }; then
        echo "WARNING: conflicting flags detected: ALL|all|system are mutually exclusive."
        echo "$0: For more info try [$0 help]: returning. with exit code 1"
        return 1
    fi
    if [ "$has_ALL" = true ] || [ "$has_all" = true ]; then
        for fn in "${actions[@]}"; do
            case "$fn" in
                search_path|search_loaded_commands|search_builtins|search_aliases|search_shell_functions|search_manpages|search_systemd_units|search_running_processes|loaded_kernel_modules|search_package_repo|search_installed_packages|search_package_files_db|search_packages_not_installed|search_home_directory|search_system_dirs)
                    # allowed (part of ALL/all)
                    ;;
                *)
                    echo "$0: when using ALL/all, only --less, --pipe, --excludeDotFiles are allowed alongside"
                    return 1
                    ;;
            esac
        done
    fi
    config_output

    [ ${#actions[@]} -eq 0 ] && {
        echo "$0: No search flags given"
        echo "$0: for more information try [$0 help]"
        return 1
    }

    [ -z "$pattern" ] && [ "${actions[0]}" = "search_path" ] && pattern="**"

    if [ "$use_less" = true ]; then
        {
            for fn in "${actions[@]}"; do
                "$fn" "$pattern"
            done
        } | less -R
    else
        for fn in "${actions[@]}"; do
            "$fn" "$pattern"
        done
    fi

    footer
}

search "$@"

