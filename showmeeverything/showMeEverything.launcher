#!/usr/bin/env zsh

# showMeEverything portable launcher
# Shell-independent entry point for Linux and Termux.
# The implementation lives in ../lib/showMeEverything/.

set -e

SELF="${0:A}"
PREFIX="${SELF:h:h}"
MODULE_DIR="$PREFIX/lib/showMeEverything"
MAIN="$MODULE_DIR/showMeEverything.zsh"

if [[ ! -f "$MAIN" ]]; then
    print -u2 "showMeEverything: implementation not found: $MAIN"
    exit 1
fi

exec /usr/bin/env zsh "$MAIN" "$@"
